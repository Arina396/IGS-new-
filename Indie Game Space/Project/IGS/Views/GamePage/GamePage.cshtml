@model IGS.Domain.ViewModels.Game.GamePageViewModel
@{
    ViewData["Title"] = Model.GameDetails.Name;
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/gamePage.css" asp-append-version="true" />

<div id="carouselExampleIndicators" class="carousel slide">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/@(Model.GameDetails.ScrinshotName ?? "carousel-plug.png")" class="d-block w-100" alt="Game Screenshot">
        </div>
        <div class="carousel-item">
            <img src="~/img/@(Model.GameDetails.ScrinshotName2 ?? "carousel-plug.png")" class="d-block w-100" alt="Game Screenshot">
        </div>
        <div class="carousel-item">
            <img src="~/img/@(Model.GameDetails.ScrinshotName3 ?? "carousel-plug.png")" class="d-block w-100" alt="Game Screenshot">
        </div>
    </div>
    <button class="carousel-control-prev control-btn-slider-left" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next control-btn-slider-right" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<section class="game-page-info">
    <article class="game-info">
        <div class="info-and-description">
            <div class="info">
                <h1 class="game-title">@Model.GameDetails.Name</h1>
                <h4>ИНФО</h4>
                <p class="game-genre">Жанры: @(Model.GameDetails.Genre ?? "Не указан")</p>
                <p class="game-developer">Разработчик: <span class="dev-nick">@Model.GameDetails.Creator</span></p>
                <br />
                <h4>КРАТКОЕ ОПИСАНИЕ</h4>
                <div class="short-description">
                    <span>@Model.GameDetails.Description</span>
                </div>
                <br />
                <h4>ПОЛНОЕ ОПИСАНИЕ</h4>
                <div class="description">
                    <span>@ViewData["LargeDescription"]</span>
                </div>
            </div>
            <div class="game-logo">
                <img src="~/img/@(Model.GameDetails.ImageName ?? "logo-game-plug.png")" alt="@Model.GameDetails.Name Logo">
                <p class="game-rating">4.5 <img src="~/img/star-checked.svg" alt="star-img"></p>
                <div class="rating">
                    <input type="radio" name="star" id="star5" />
                    <label for="star5" class="star"></label>
                    <input type="radio" name="star" id="star4" />
                    <label for="star4" class="star"></label>
                    <input type="radio" name="star" id="star3" />
                    <label for="star3" class="star"></label>
                    <input type="radio" name="star" id="star2" />
                    <label for="star2" class="star"></label>
                    <input type="radio" name="star" id="star1" />
                    <label for="star1" class="star"></label>
                </div>
            </div>
        </div>
    </article>

    <div class="download-buttons">
        <h4>СКАЧАТЬ</h4>
        <div class="buttons">
            @if (!string.IsNullOrEmpty(Model.GameDetails.Link))
            {
                <a href="@Model.GameDetails.Link" class="OS-buttons">Windows</a>
            }
            else
            {
                <button class="OS-buttons" disabled>Windows</button>
            }
           
        </div>
    </div>
</section>

<section class="comments">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="post" asp-action="AddComment" asp-controller="GamePage">
        <div class="comment-input">
            <label for="comment-text">КОММЕНТАРИИ</label>
            <div class="comment-input-wrapper">
                <input type="text" name="commentText" id="comment-text" placeholder="Ваш комментарий" required />
                <button type="submit" class="send-button">
                    <img src="~/img/SendCommentBtn.svg" alt="Send" />
                </button>
                <input type="hidden" name="gameId" value="@Model.GameDetails.Id" />
            </div>
        </div>
    </form>

    <div class="comments-list">
        @foreach (var comment in Model.Comments)
        {
            <div class="comment-item">
                <div class="comment-header">
                    <div class="avatar-wrapper">
                        <img src="~/img/star.svg" alt="User Avatar" />
                    </div>
                    <span>@comment.UserName</span>
                </div>
                <div class="comment-body">
                    <span>@comment.Comment</span>
                </div>
            </div>
        }
    </div>
</section>