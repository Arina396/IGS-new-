@model IGS.Domain.ViewModels.Game.AddGameFormModel

<link rel="stylesheet" href="~/css/addGameForm.css" asp-append-version="true" />

<form asp-action="AddGameForm" method="post" enctype="multipart/form-data" class="add-game">
    <h1>СОЗДАЙТЕ НОВЫЙ ПРОЕКТ</h1>

    <!-- Сводка валидации -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Название игры -->
    <div class="game-add-input-wrapper">
        <label asp-for="Name">Название</label>
        <input asp-for="Name" placeholder="Введите название" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- Краткое описание -->
    <div class="game-add-input-wrapper">
        <label asp-for="ShortDescription">Краткое описание</label>
        <input asp-for="ShortDescription" placeholder="Введите описание" />
        <span asp-validation-for="ShortDescription" class="text-danger"></span>
    </div>

    <!-- Загрузка файлов -->
    <div class="game-add-input-file-wrapper">
        <!-- Обложка -->
        <div class="game-cover">
            <h2>ОБЛОЖКА</h2>
            <label for="Cover" class="custom-file-label">Добавить</label>
            <input type="file" asp-for="Cover" />
            <div class="file-drop-area" id="file-drop-area"></div>
            <span asp-validation-for="Cover" class="text-danger"></span>
        </div>


        <div class="add-screenshots">
        <!-- Скриншот -->
            <h2>СКРИНШОТЫ</h2>
        <div class="screenshots">
            <label for="Screenshot" class="custom-file-label">Добавить</label>
            <input type="file" asp-for="Screenshot" />
            <div class="file-drop-area" id="file-drop-area"></div>
            <span asp-validation-for="Screenshot" class="text-danger"></span>
        </div>

        <div class="screenshots">
            <label for="Screenshot2" class="custom-file-label">Добавить</label>
            <input type="file" asp-for="Screenshot2" />
            <div class="file-drop-area" id="file-drop-area"></div>
            <span asp-validation-for="Screenshot2" class="text-danger"></span>
        </div>

        <div class="screenshots">
            <label for="Screenshot3" class="custom-file-label">Добавить</label>
            <input type="file" asp-for="Screenshot3" />
            <div class="file-drop-area" id="file-drop-area"></div>
            <span asp-validation-for="Screenshot3" class="text-danger"></span>
        </div>
        </div>
    </div>

    <div class="game-add-input-wrapper more-description">
        <label asp-for="AdditionalDescription">Подробное описание</label>
        <textarea asp-for="AdditionalDescription" placeholder="Введите описание" rows="10"></textarea>
        <span asp-validation-for="AdditionalDescription" class="text-danger"></span>
    </div>

    <div class="game-add-input-wrapper">
        <label asp-for="Link">Добавление ссылки на игру</label>
        <input asp-for="Link" placeholder="Введите ссылку" />
        <span asp-validation-for="Link" class="text-danger"></span>
    </div>

    <div class="game-add-input-wrapper">
        <label asp-for="Creator">Навзание команды / Разработчика</label>
        <input asp-for="Creator" placeholder="Введите название" />
        <span asp-validation-for="Creator" class="text-danger"></span>
    </div>

    <div class="game-add-input-wrapper">
        <label asp-for="Genre">Жанр</label>
        <input asp-for="Genre" placeholder="Введите жанр" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>

    <!-- Кнопка отправки -->
    <button type="submit" class="save-page-button">сохранить и посмотреть страницу</button>
</form>