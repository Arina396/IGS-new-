@model IGS.Views.JamRegistration.IndexModel
<link rel="stylesheet" href="~/css/jamRegistration.css" asp-append-version="true" />
@{
}

<form action="/" method="post" class="regForm">
    <h1>Регистрация на джем</h1>
    <input type="text" name="nameOfTeam" placeholder="Название команды" />    
