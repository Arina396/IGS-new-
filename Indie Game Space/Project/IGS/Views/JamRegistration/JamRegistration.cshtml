@model IGS.Domain.ViewModels.Jam.JamRegistrationModel
<link rel="stylesheet" href="~/css/jamRegistration.css" asp-append-version="true" />

<form asp-action="JamRegistration" method="post" class="regForm">
    <h1>Регистрация на джем</h1>

    <!-- Сводка валидации -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Название команды -->
    <div>
        <input asp-for="NameOfTeam" placeholder="Введите название команды" />
        <span asp-validation-for="NameOfTeam" class="text-danger"></span>
    </div>

    <!-- Ник капитана -->
    <div>
        <input asp-for="NameOfCapitan" placeholder="Введите ник капитана" />
        <span asp-validation-for="NameOfCapitan" class="text-danger"></span>
    </div>

    <!-- Ники участников -->
    <div>
        <input asp-for="MembersOfTeam" placeholder="Введите ники участников" />
        <span asp-validation-for="MembersOfTeam" class="text-danger"></span>
    </div>

    <!-- Кнопка отправки -->
    <button type="submit" class="btn">Участвовать</button>
</form>